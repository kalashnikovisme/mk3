#!/usr/bin/env ruby

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "fileutils"
require "fighting_ai/cli/bootstrap"

SHOW_ERRORS_ENV   = "SHOW_ERRORS"
SHOW_ERRORS_VALUE = "1"
$stderr.reopen(File::NULL, "w") unless ENV[SHOW_ERRORS_ENV] == SHOW_ERRORS_VALUE

ROM_PATH           = ENV.fetch("ROM_PATH", File.expand_path("../mk3.sfc", __dir__))
CORE_PATH          = ENV.fetch("CORE_PATH", "/usr/lib/x86_64-linux-gnu/libretro/snes9x_libretro.so")
MATCHES_DIR        = File.expand_path("../data/matches", __dir__)
FIGHT_LOGS_DIR     = File.expand_path("../data/fight_logs", __dir__)
DEFAULT_MATCH_NAME = "sub-zero-vs-sub-zero"
HEALTH_DETECTOR_ARGUMENT = "health"
TIME_DETECTOR_ARGUMENT   = "time"
POSITIONS_DETECTOR_ARGUMENT = "positions"
MAXIMUM_MATCH_ARGUMENTS  = 1
arguments = ARGV.dup
health_enabled = arguments.delete(HEALTH_DETECTOR_ARGUMENT)
time_enabled = arguments.delete(TIME_DETECTOR_ARGUMENT)
positions_enabled = arguments.delete(POSITIONS_DETECTOR_ARGUMENT)
if arguments.size > MAXIMUM_MATCH_ARGUMENTS
  raise "Usage: dip learn_empty [#{HEALTH_DETECTOR_ARGUMENT}] [#{TIME_DETECTOR_ARGUMENT}] " \
    "[#{POSITIONS_DETECTOR_ARGUMENT}] [match-name]"
end
MATCH_NAME = arguments.first || ENV.fetch("MATCH", DEFAULT_MATCH_NAME)
FRAMES_PER_GAME_SECOND       = 60
DEFAULT_EPISODE_FRAME_LIMIT  = FightingAI::Game::MortalKombat3::MemoryMap::TIMER_MAX * FRAMES_PER_GAME_SECOND
EPISODE_FRAME_LIMIT_ENV      = "LEARN_EMPTY_EPISODE_FRAMES"
EPISODE_FRAME_LIMIT          = Integer(ENV.fetch(EPISODE_FRAME_LIMIT_ENV, DEFAULT_EPISODE_FRAME_LIMIT))
MINIMUM_EPISODE_FRAME_LIMIT  = 1
INITIAL_EPISODE_NUMBER       = 1
EPISODE_INCREMENT            = 1
EPISODE_LOG_FILENAME_FORMAT  = "episode_%05d.log"

unless EPISODE_FRAME_LIMIT >= MINIMUM_EPISODE_FRAME_LIMIT
  raise "#{EPISODE_FRAME_LIMIT_ENV} must be at least #{MINIMUM_EPISODE_FRAME_LIMIT}"
end

match_path = File.join(MATCHES_DIR, "#{MATCH_NAME}.state")
raise "Match state not found: #{match_path}" unless File.file?(match_path)

states_dir = FightingAI::Emulator::RetroArch::ConfigBuilder::STATES_DIR
FileUtils.rm_rf(states_dir)
FileUtils.mkdir_p(states_dir)
FileUtils.cp(match_path, File.join(states_dir, "#{File.basename(ROM_PATH, '.*')}.state"))

emulator = FightingAI::CLI.start_retro_arch(
  rom_path:         ROM_PATH,
  core_path:        CORE_PATH,
  extra_watch_dirs: [MATCHES_DIR],
  verbose:          false,
  streaming:        true
)
metadata_detectors = []
if health_enabled
  health_detector = FightingAI::Vision::HealthBarDetector.new(
    bar1: FightingAI::Game::MortalKombat3::Adapter::P1_HEALTH_BAR,
    bar2: FightingAI::Game::MortalKombat3::Adapter::P2_HEALTH_BAR,
    max_health: FightingAI::Game::MortalKombat3::MemoryMap::MAX_HEALTH
  )
  metadata_detectors << lambda do |frame|
    health = health_detector.detect(frame)
    {
      h1: health.fetch(FightingAI::Game::MortalKombat3::Adapter::PLAYER_ONE),
      h2: health.fetch(FightingAI::Game::MortalKombat3::Adapter::PLAYER_TWO)
    }
  end
end
position_detector = if positions_enabled
  detector = FightingAI::Vision::CharacterPositionDetector.new(detect_timer: !!time_enabled)
  FightingAI::Vision::PositionDetector.new(detector: detector)
end
timer_detector = FightingAI::Vision::TimerDetector.new if time_enabled && !position_detector
metadata_detectors << ->(frame) { { t: timer_detector.detect(frame) } } if timer_detector
if position_detector
  metadata_detectors << lambda do |frame|
    result = position_detector.detect(frame)
    player1 = result[:player1]
    player2 = result[:player2]
    metadata = {}
    metadata[:t] = result[:timer] if time_enabled
    metadata.merge(
      x1: player1&.fetch(:x),
      y1: player1&.fetch(:y),
      x2: player2&.fetch(:x),
      y2: player2&.fetch(:y)
    )
  end
end
metadata_detector = unless metadata_detectors.empty?
  lambda do |frame|
    metadata_detectors.each_with_object({}) do |detector, metadata|
      metadata.merge!(detector.call(frame))
    end
  end
end
FileUtils.rm_rf(FIGHT_LOGS_DIR)
FileUtils.mkdir_p(FIGHT_LOGS_DIR)
timer_detector&.start
position_detector&.start
emulator.install_match_state_paused(match_path)
episode_number = INITIAL_EPISODE_NUMBER
runner = nil
stop_requested = false
Signal.trap("INT") do
  stop_requested = true
  runner&.stop
end

begin
  loop do
    break if stop_requested
    emulator.frame_advance

    log_path = File.join(FIGHT_LOGS_DIR, format(EPISODE_LOG_FILENAME_FORMAT, episode_number))
    File.open(log_path, "w") do |log_file|
      log_file.sync = true
      runner = FightingAI::Runtime::FrameCaptureRunner.new(
        emulator:    emulator,
        output:      log_file,
        frame_limit: EPISODE_FRAME_LIMIT,
        metadata_detector: metadata_detector
      )
      runner.run
    end

    break if stop_requested || runner.interrupted?

    episode_number += EPISODE_INCREMENT
    emulator.install_match_state(match_path)
  end
ensure
  timer_detector&.stop
  position_detector&.stop
  emulator.stop
end
