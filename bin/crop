#!/usr/bin/env python3
# Crop an image by pixel coordinates and save the result.
# Usage:
#   python3 bin/crop <image> <x> <y> <width> <height> [output]
#
# Example:
#   python3 bin/crop data/screenshots/frame_001.png 120 8 57 14 timer.png

import sys
import os
from PIL import Image

if len(sys.argv) not in (6, 7):
    print(f"Usage: {sys.argv[0]} <image> <x> <y> <width> <height> [output]", file=sys.stderr)
    sys.exit(1)

src        = sys.argv[1]
x, y, w, h = int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4]), int(sys.argv[5])

if len(sys.argv) == 7:
    dest = sys.argv[6]
else:
    base, ext = os.path.splitext(src)
    dest = f"{base}_crop_{x}_{y}_{w}x{h}{ext}"

if not os.path.exists(src):
    print(f"File not found: {src}", file=sys.stderr)
    sys.exit(1)

img     = Image.open(src)
cropped = img.crop((x, y, x + w, y + h))
cropped.save(dest)
print(dest)
