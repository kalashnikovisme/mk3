#!/usr/bin/env ruby
# Execute a hand-written scenario against a live RetroArch match state.
# Usage:
#   bundle exec ruby bin/scenario [scenario_file]
# Defaults to scenario.rb in the project root.
#
# Inside the scenario file, P1 and P2 are PlayerProxy objects:
#   P1.right(10)        # hold right for 10 frames
#   P1.low_punch        # press low punch for 1 frame
#   P2.block(5)         # P2 holds block for 5 frames
#   wait(30)            # pause both players for 30 frames (~0.5 s)
#   P1.ice_ball         # Sub-Zero: D, F + LP (assumes facing right)
#   P1.ice_clone        # Sub-Zero: D, B + LP
#   P1.slide            # Sub-Zero: B + BL + LP + LK
#   save_state "label"  # save RetroArch state and copy to /app/data/states/<label>.state
#   save_state          # same, auto-named by timestamp
#   save_memory "label" # save WRAM hex dump to /app/data/memory/<label>
#   save_memory         # same, auto-named by timestamp

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "fighting_ai/cli/bootstrap"
require "fighting_ai/scenario/speed"
require "fighting_ai/scenario/state"
require "fighting_ai/scenario/player_proxy"
require_relative "../config/mk3"

ROM_PATH        = ENV.fetch("ROM_PATH",  File.expand_path("../mk3.sfc", __dir__))
CORE_PATH       = ENV.fetch("CORE_PATH", "/usr/lib/x86_64-linux-gnu/libretro/snes9x_libretro.so")
MATCHES_DIR     = File.expand_path("../data/matches", __dir__)
MEMORY_DEBUG    = ARGV.delete("--memory-debug") != nil
MEMORY_DUMP_DIR = "/app/data/memory"

SCENARIO_FILE = ARGV[0] || File.expand_path("../scenario.rb", __dir__)
raise "Scenario file not found: #{SCENARIO_FILE}" unless File.exist?(SCENARIO_FILE)

MATCH_FILTER = ARGV[1] || ENV["MATCH"] || "sub-zero-vs-sub-zero"

# ── Load match state ──────────────────────────────────────────────────────────

match_states = Dir.glob(File.join(MATCHES_DIR, "*.state")).sort
raise "No .state files found in #{MATCHES_DIR}" if match_states.empty?

match_state = match_states.find { |p| File.basename(p, ".state") == MATCH_FILTER } ||
              match_states.first
states_dir  = FightingAI::Emulator::RetroArch::ConfigBuilder::STATES_DIR
rom_base    = File.basename(ROM_PATH, ".*")
FileUtils.mkdir_p(states_dir)
FileUtils.cp(match_state, File.join(states_dir, "#{rom_base}.state"))

FileUtils.mkdir_p(MEMORY_DUMP_DIR)
FileUtils.rm_f(Dir.glob("#{MEMORY_DUMP_DIR}/*.bin"))
if MEMORY_DEBUG
  FileUtils.rm_f(Dir.glob("#{MEMORY_DUMP_DIR}/*"))
end

puts FightingAI::CLI::BANNER
puts "Mode: Scenario#{MEMORY_DEBUG ? " [memory debug]" : ""}\n\n"
puts "State  → #{File.basename(match_state)}"
puts "Script → #{SCENARIO_FILE}"
puts "Memory → #{MEMORY_DUMP_DIR}"
puts

FightingAI::CLI.trap_sigint

emulator = FightingAI::CLI.start_retro_arch(
  rom_path:         ROM_PATH,
  core_path:        CORE_PATH,
  extra_watch_dirs: [MATCHES_DIR]
)

emulator.install_match_state(match_state)

# ── Build DSL context ─────────────────────────────────────────────────────────

FightingAI::Scenario.emulator           = emulator
FightingAI::Scenario.initial_state_path = match_state
FightingAI::Scenario.set_speed(:normal)   # ensure clean state before scenario runs

P1 = FightingAI::Scenario::PlayerProxy.new(1, emulator)
P2 = FightingAI::Scenario::PlayerProxy.new(2, emulator)

def speed(preset_or_multiplier)
  FightingAI::Scenario.set_speed(preset_or_multiplier)
end

def wait(frames)
  sleep(frames * FightingAI::Scenario.frame_duration)
end

def save_state(name = nil)
  FightingAI::Scenario.save_state(name)
end

def save_memory(name = nil)
  FightingAI::Scenario.save_memory(name)
end

def watch(address, label: nil)
  FightingAI::Scenario.watch(address, label: label)
end

def reload_state
  FightingAI::Scenario.reload_state
end

# ── Status display ────────────────────────────────────────────────────────────

game    = FightingAI.build_mk3_adapter(emulator_adapter: emulator)
display = FightingAI::CLI::PPODisplay.new

status_thread = Thread.new do
  loop do
    snapshot   = emulator.next_frame_snapshot
    game_state = game.extract_game_state(snapshot)
    watches    = FightingAI::Scenario.watches.map do |w|
      { label: w[:label], value: emulator.read_memory(w[:address]) }
    end
    display.update(game_state: game_state, stage_name: game.snapshot_stage_name(snapshot), watches: watches)
  rescue => e
    next if e.is_a?(ThreadError)
    $stderr.puts "[status thread] #{e.class}: #{e.message}"
    next
  end
end

memory_thread = MEMORY_DEBUG ? Thread.new do
  frame_index = 0
  loop do
    frame_index += 1
    path = File.join(MEMORY_DUMP_DIR, format("%06d", frame_index))
    File.write(path, emulator.wram_hex_dump)
    display.log("💾 [memory] #{File.basename(path)}".yellow)
  rescue => e
    next if e.is_a?(ThreadError)
    $stderr.puts "[memory thread] #{e.class}: #{e.message}"
    next
  end
end : nil

# ── Run scenario ──────────────────────────────────────────────────────────────

puts "Running #{File.basename(SCENARIO_FILE)}...\n\n"
load SCENARIO_FILE

status_thread.kill
memory_thread&.kill
$stdout.print "\n"
puts "Scenario complete."

# ── Verify binary dump sizes ──────────────────────────────────────────────────

bin_files = Dir.glob(File.join(MEMORY_DUMP_DIR, "*.bin")).sort
if bin_files.any?
  sizes = bin_files.map { |f| [File.basename(f), File.size(f)] }
  unique_sizes = sizes.map(&:last).uniq
  puts "\nMemory dump size verification:"
  sizes.each { |name, size| puts "  #{name}: #{size} bytes" }
  if unique_sizes.size == 1
    puts "✓ All #{bin_files.size} dumps: #{unique_sizes.first} bytes (#{unique_sizes.first / 1024} KB)"
  else
    puts "✗ Size mismatch — unique sizes: #{unique_sizes.inspect}"
  end
end

emulator.stop
