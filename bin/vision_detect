#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "chunky_png"
require "colorize"
require "fighting_ai/vision/health_bar_detector"
require "fighting_ai/vision/character_position_detector"

VERBOSE_FLAG = "--verbose"
PNG_EXTENSION = ".png"
FIRST_HUMAN_INDEX = 1
VERBOSE_RANK_WIDTH = 2

P1_HEALTH_BAR = FightingAI::Vision::HealthBarDetector::BarConfig.new(
  x: 19, y: 19, width: 112, height: 10, direction: :left_to_right
).freeze

P2_HEALTH_BAR = FightingAI::Vision::HealthBarDetector::BarConfig.new(
  x: 168, y: 19, width: 112, height: 10, direction: :right_to_left
).freeze

MAX_HEALTH        = 0xA6
HIGH_HEALTH_RATIO = 0.6
LOW_HEALTH_RATIO  = 0.3

FramePixels = Data.define(:pixels, :width) do
  def pixel_rgb(x, y)
    pixels[y * width + x]
  end
end

HEALTH_DETECTOR = FightingAI::Vision::HealthBarDetector.new(
  bar1: P1_HEALTH_BAR,
  bar2: P2_HEALTH_BAR,
  max_health: MAX_HEALTH
).freeze

def health_color(health)
  ratio = health.to_f / MAX_HEALTH
  label = "#{health}/#{MAX_HEALTH}"
  if ratio > HIGH_HEALTH_RATIO
    label.green
  elsif ratio > LOW_HEALTH_RATIO
    label.yellow
  else
    label.red
  end
end

def confidence_color(confidence)
  label = format("%.3f", confidence)
  if confidence >= 0.9
    label.green
  elsif confidence >= 0.85
    label.yellow
  else
    label.red
  end
end

def detect_health(path)
  image = ChunkyPNG::Image.from_file(path)
  pixels = Array.new(image.width * image.height) do |i|
    pixel = image[i % image.width, i / image.width]
    [ChunkyPNG::Color.r(pixel), ChunkyPNG::Color.g(pixel), ChunkyPNG::Color.b(pixel)]
  end
  HEALTH_DETECTOR.detect(FramePixels.new(pixels: pixels, width: image.width))
end

def print_file_result(result, path)
  puts path
  detections   = result[:detections]
  candidates   = result[:candidates]
  image_width  = result[:image_width]
  image_height = result[:image_height]

  if detections.empty?
    puts "  detections: none"
  else
    detections.each_with_index do |d, i|
      scaled = FightingAI::Vision::CharacterPositionDetector.scale_position(
        d, image_width: image_width, image_height: image_height
      )
      puts "  ##{i + 1} #{d.template_name.bold}  action=#{d.action}  mk3=(#{scaled[:x]},#{scaled[:y]})  conf=#{format('%.3f', d.confidence).green}"
    end
  end

  timer    = result[:timer]
  detect_ms = result[:detect_ms]
  puts "  timer:     #{timer ? timer.to_s.cyan : 'not detected'}"
  puts "  detect_ms: #{detect_ms ? detect_ms.to_s.yellow : 'n/a'}"

  health = detect_health(path)
  { 1 => result[:player1], 2 => result[:player2] }.each do |player_index, detection|
    hp = health_color(health[player_index])
    if detection
      scaled = FightingAI::Vision::CharacterPositionDetector.scale_position(
        detection, image_width: image_width, image_height: image_height
      )
      puts "  P#{player_index}: #{hp}  x=#{scaled[:x]} y=#{scaled[:y]}  action=#{detection.action}"
    else
      puts "  P#{player_index}: #{hp}  position=not detected"
    end
  end

  return unless verbose?

  if candidates.empty?
    puts "  candidates: none"
  else
    puts "  candidates:"
    candidates.sort_by { |candidate| -candidate.confidence }.each_with_index do |candidate, index|
      scaled = FightingAI::Vision::CharacterPositionDetector.scale_position(
        candidate, image_width: image_width, image_height: image_height
      )
      rank = format("%0#{VERBOSE_RANK_WIDTH}d", index + FIRST_HUMAN_INDEX).cyan
      puts "    ##{rank} #{candidate.template_name.bold}  action=#{candidate.action}  " \
           "box=(#{candidate.x},#{candidate.y} #{candidate.width}x#{candidate.height})  " \
           "foot=(#{candidate.center_x},#{candidate.bottom_y})  " \
           "mk3=(#{scaled[:x]},#{scaled[:y]})  conf=#{confidence_color(candidate.confidence)}"
    end
  end
rescue => e
  puts "  health: #{e.message}".red
ensure
  puts
end

def verbose?
  @verbose == true
end

arguments = ARGV.dup
@verbose = !!arguments.delete(VERBOSE_FLAG)
png_paths  = arguments.select { |argument| argument.end_with?(PNG_EXTENSION) }
action_arg = (arguments - png_paths).first

if png_paths.empty?
  warn "Usage: dip vision:detect [action] [#{VERBOSE_FLAG}] <screenshot.png> [more.png ...]"
  exit 1
end

detector = FightingAI::Vision::CharacterPositionDetector.new(
  action_mode:  action_arg || ENV.fetch(
    FightingAI::Vision::CharacterPositionDetector::VISION_ACTION_ENV,
    FightingAI::Vision::CharacterPositionDetector::DEFAULT_ACTION_MODE
  ),
  detect_timer: true
)

png_paths.each { |path| print_file_result(detector.detect_path(File.expand_path(path)), path) }
detector.stop
